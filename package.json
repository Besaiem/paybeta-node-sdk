{
  "name": "@paybetaby/node-sdk",
  "version": "1.0.0",
  "description": "Official Node.js SDK for the Paybeta payments API",
  "repository": {
    "type": "git",
    "url": "https://github.com/Besaiem/paybeta-node-sdk"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "release": "release-it",
    "release:dry": "release-it --dry-run",
    "prepare": "husky"
  },
  "keywords": [
    "paybeta",
    "payments",
    "escrow",
    "sdk",
    "nigeria",
    "ngn"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@release-it/conventional-changelog": "^8.0.0",
    "@types/node": "^20.0.0",
    "husky": "^9.1.7",
    "release-it": "^17.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.4.0"
  }
}
